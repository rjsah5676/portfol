# 이 파일을 .env 로 복사해서 필요한 값만 채우면 됩니다. (전부 비워둬도 로컬 개발은 됩니다)
# npm run dev / npm start / npm run import:firestore 가 server/.env 를 읽습니다.
# 셸·Docker 에서 직접 지정한 환경변수가 있으면 그 값이 우선합니다.

# 서버 포트
PORT=4000

# MongoDB 주소. 비워두면 개발 모드에서 내장 MongoDB 를 자동으로 띄움 (첫 실행 때 mongod 를 내려받음)
# 예) docker compose up -d mongo 로 띄운 DB: mongodb://localhost:27017
# 운영(NODE_ENV=production)에서는 반드시 지정
MONGODB_URI=

# 내장 MongoDB 의 데이터 폴더. 비워두면 사용자 홈 아래 .portfolio-dev/mongo
# (레포가 OneDrive 같은 동기화 폴더에 있어도 DB 파일이 동기화에 걸리지 않게 레포 밖에 둠)
# MONGO_DATA_DIR=

# 데이터베이스 이름
MONGODB_DB=portfolio

# 서버를 호출할 수 있는 프론트 주소 (쉼표로 여러 개, * = 전부 허용)
# 비워두면 개발 모드에서는 전부 허용, 운영에서는 전부 차단
# 예) https://gunmo.my
CORS_ORIGINS=

# 로그인 토큰을 검증할 Firebase 프로젝트 id (프론트 web/src/firebase.ts 의 projectId 와 같아야 함)
FIREBASE_PROJECT_ID=gunmo-portfolio

# 관리자 계정 이메일 (쉼표로 여러 개). 이 이메일의 계정으로 로그인하면 관리자
ADMIN_EMAILS=rjsah5676@gmail.com

# 관리자 계정이 처음 로그인할 때 자동으로 붙는 별명 (다른 사람은 이 별명을 못 씀)
# ADMIN_NICK=이건모

# 프록시(nginx·로드밸런서) 뒤에 둘 때 거쳐 오는 프록시 단계 수. 직접 받으면 0
# (요청 횟수 제한이 프록시 IP 가 아니라 실제 접속자 IP 기준으로 걸리게 함)
TRUST_PROXY=0

# 유입 분석에서 IP로 국가·지역 찾기 (geoip-lite, 메모리 약 100MB 더 씀). 0 이면 끔 (위치는 빈 값)
# TRAFFIC_GEO=1

# 글을 쓰거나 고쳤을 때 프론트(Next 서버)에 알려 캐시를 바로 비움. 둘 다 있어야 동작
# 비워두면 알리지 않음 → 프론트가 1분마다 스스로 갱신 (개발 서버 npm run dev 는 캐시 없이 매번 새로 읽어서 필요 없음)
# REVALIDATE_SECRET 은 web/.env.local 의 값과 같아야 함
# WEB_REVALIDATE_URL=http://localhost:3000/internal/revalidate/
# REVALIDATE_SECRET=

# Firebase ID 토큰 서명 검증용 공개키 주소. 보통 건드릴 필요 없음
# AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# ── npm run import:firestore 전용 (서버는 쓰지 않음) ──
# 문의(inquiries)까지 옮기려면 관리자 계정을 지정. 옮긴 뒤에는 지우는 것을 권장
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
