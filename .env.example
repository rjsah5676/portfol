# docker compose 로 전체를 띄울 때 쓰는 값. 이 파일을 .env 로 복사해서 채우면 됩니다.
# (로컬 개발 npm run dev 에는 필요 없음 — 그쪽은 server/.env, web/.env.local)

# 사이트 주소. 도메인을 적으면 프록시(Caddy)가 HTTPS 인증서를 자동으로 받음. 비우면 http://localhost
SITE_ADDRESS=gunmo.my

# 정식 주소 (canonical·사이트맵·공유 이미지 주소). 프론트 이미지를 빌드할 때 들어감
SITE_URL=https://gunmo.my

# 글이 바뀌었을 때 백엔드 → 프론트 캐시 갱신 알림에 쓰는 비밀값. 아무 긴 문자열 (비우면 1분마다 스스로 갱신)
REVALIDATE_SECRET=

# 익명 랭킹 · 방명록 · 문의의 사람 확인 (Cloudflare 대시보드 → Turnstile 위젯의 사이트 키 · 비밀 키). 비우면 확인 안 함
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 관리자 계정 이메일 (쉼표로 여러 개)
ADMIN_EMAILS=rjsah5676@gmail.com,cksqls9706@gmail.com

# MONGODB_DB=portfolio
# FIREBASE_PROJECT_ID=gunmo-portfolio
# 다른 주소의 페이지에서도 API 를 부르게 하려면 (쉼표로 여러 개)
# CORS_ORIGINS=https://gunmo.my
# 레지스트리에서 받은 이미지를 쓸 때 (CI 가 올린 것)
# SERVER_IMAGE=ghcr.io/<계정>/<레포>-server:latest
# WEB_IMAGE=ghcr.io/<계정>/<레포>-web:latest
