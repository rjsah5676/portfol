# 이 파일을 .env.local 로 복사해서 필요한 값만 채우면 됩니다. (비워둬도 로컬 개발은 됩니다)

# 브라우저가 호출할 백엔드(API·웹소켓) 주소. 빌드할 때 결과물에 박힘
# 비워두면 http://localhost:4000, "/" 는 사이트와 같은 주소 (프록시가 /api, /socket.io 를 백엔드로 넘겨줄 때)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Next 서버가 페이지를 그릴 때 백엔드를 부르는 주소. 브라우저용 주소와 다를 때만 지정
# (예: docker compose 안에서는 http://server:4000)
# API_URL=

# 정식 사이트 주소 (canonical·사이트맵·공유 이미지 주소). 빌드할 때 결과물에 박힘. 비워두면 https://gunmo.my
# NEXT_PUBLIC_SITE_URL=https://gunmo.my

# 글이 바뀌었을 때 백엔드가 보내는 캐시 갱신 알림의 비밀값 (server/.env 의 REVALIDATE_SECRET 과 같은 값)
# 비워두면 알림을 받지 않고 1분마다 스스로 갱신
# REVALIDATE_SECRET=
